+/* ══ 06 / BERT MUSIC ══ */
+.music-promo { position: relative; overflow: hidden; padding: 92px 0; background: var(--cream-soft); }
+.music-promo__row { display: grid; grid-template-columns: .9fr 1.1fr; gap: 64px; align-items: center; }
+.music-promo__copy { display: flex; flex-direction: column; align-items: flex-start; }
+.music-promo__tracks { width: 100%; margin: 26px 0 30px; border-block: 1px solid var(--hair-light); }
+.music-promo__tracks span { display: flex; gap: 18px; padding: 13px 0; font-family: 'Baloo 2', sans-serif; font-size: 17px; font-weight: 600; border-bottom: 1px solid var(--hair-light); }
+.music-promo__tracks span:last-child { border: 0; }
+.music-promo__tracks b { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .1em; color: var(--accent); align-self: center; }
+.music-promo__art { position: relative; min-height: 430px; overflow: hidden; border-radius: 28px; background: radial-gradient(circle at 72% 40%, #28325f, var(--navy) 46%, var(--navy-deep)); border: 1px solid rgba(255,255,255,.1); box-shadow: var(--shadow-dark); transition: transform var(--dur-reveal) var(--ease-emph); }
+.music-promo__art:hover { transform: translateY(-5px) rotate(.4deg); }
+.music-promo__record { position: absolute; width: 310px; aspect-ratio: 1; border-radius: 50%; right: 9%; top: 44px; background: repeating-radial-gradient(circle, #15182a 0 3px, #090b16 4px 7px); box-shadow: 0 25px 50px rgba(0,0,0,.45); }
+.music-promo__record::before { content: ''; position: absolute; inset: 35%; border-radius: 50%; background: var(--accent); box-shadow: inset 0 0 0 8px rgba(255,255,255,.08); }
+.music-promo__record i { position: absolute; width: 20px; aspect-ratio: 1; left: calc(50% - 10px); top: calc(50% - 10px); border-radius: 50%; background: var(--cream); z-index: 1; }
+.music-promo__signal { position: absolute; left: 40px; bottom: 74px; display: flex; align-items: end; gap: 7px; height: 96px; }
+.music-promo__signal i { width: 8px; height: 34%; border-radius: 6px; background: var(--accent); }
+.music-promo__signal i:nth-child(2), .music-promo__signal i:nth-child(6) { height: 62%; }
+.music-promo__signal i:nth-child(3), .music-promo__signal i:nth-child(5) { height: 88%; }
+.music-promo__signal i:nth-child(4) { height: 48%; }
+.music-promo__label { position: absolute; left: 40px; bottom: 30px; font-family: 'JetBrains Mono', monospace; font-size: 9px; line-height: 1.6; letter-spacing: .12em; color: var(--on-dark-mut); }
+.music-promo__label b { color: var(--accent-2); }
+
+/* dedicated music page */
+.music-page { background: var(--navy-deep); }
+.subnav { background: var(--navy-deep); border-bottom: 1px solid var(--hair-dark); }
+.subnav__inner { min-height: 88px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
+.subnav .wordmark { color: var(--cream-text); font-size: 25px; }
+.subnav nav { display: flex; align-items: center; gap: 22px; color: var(--cream-text); font-size: 14px; }
+.music-hero { position: relative; overflow: hidden; padding: 110px 0 100px; background: var(--navy); }
+.music-hero::before { content: ''; position: absolute; width: 760px; height: 760px; right: -250px; top: -360px; border-radius: 50%; background: radial-gradient(circle, rgba(236,74,38,.24), transparent 68%); }
+.music-hero__inner { position: relative; display: grid; grid-template-columns: 1fr 360px; align-items: center; gap: 60px; }
+.music-hero .eyebrow { margin-bottom: 24px; }
+.music-hero h1 { font-family: 'Baloo 2', sans-serif; font-weight: 800; font-size: clamp(58px, 8vw, 102px); line-height: .9; letter-spacing: -.025em; color: var(--cream-text); }
+.music-hero p:last-child { max-width: 46ch; margin-top: 24px; font-size: 18px; color: var(--on-dark-mut); }
+.music-hero__mark { width: 330px; aspect-ratio: 1; border-radius: 50%; background: repeating-radial-gradient(circle, #171b31 0 4px, #080b19 5px 9px); box-shadow: 0 28px 70px rgba(0,0,0,.48); animation: spin 18s linear infinite; }
+.music-hero__mark::before { content: ''; position: absolute; width: 120px; aspect-ratio: 1; margin: 105px; border-radius: 50%; background: var(--accent); }
+.music-hero__mark span { position: absolute; width: 22px; aspect-ratio: 1; margin: 154px; border-radius: 50%; background: var(--cream); z-index: 1; }
+@keyframes spin { to { transform: rotate(360deg); } }
+.music-library { padding: 96px 0 110px; background: var(--cream); }
+.music-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; margin-top: 44px; }
+.music-card { overflow: hidden; border-radius: 22px; background: var(--card-warm); border: 1px solid var(--hair-light); box-shadow: var(--shadow-raise); }
+.music-card--wide { grid-column: 1 / -1; display: grid; grid-template-columns: 1.45fr .55fr; }
+.music-card__player { aspect-ratio: 16 / 9; background: #000; }
+.music-card__player iframe { width: 100%; height: 100%; display: block; border: 0; }
+.music-card__meta { padding: 24px 26px 28px; }
+.music-card--wide .music-card__meta { display: flex; flex-direction: column; justify-content: center; padding: 38px; }
+.music-card__meta > span { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .12em; color: var(--accent); }
+.music-card__meta h3 { margin-top: 7px; font-family: 'Baloo 2', sans-serif; font-size: 25px; line-height: 1.1; }
+.music-card__meta a { display: inline-block; margin-top: 13px; font-size: 13px; color: var(--ink-muted); text-decoration: underline; text-underline-offset: 3px; }
+.music-channel { display: flex; align-items: center; justify-content: space-between; gap: 30px; margin-top: 52px; padding: 34px 38px; border-radius: 22px; background: var(--navy); color: var(--cream-text); }
+.music-channel h2 { margin-top: 6px; font-family: 'Baloo 2', sans-serif; font-size: 28px; }
+.music-page .footer { padding: 36px 0; }
+
 .cta-band { position: relative; overflow: hidden; background: var(--accent); color: #fff6f0; padding: 84px 0; text-align: left; }
 .cta-band::before { content: ''; position: absolute; inset: 0; background: radial-gradient(62% 130% at 50% -12%, rgba(255,255,255,.20), transparent 62%); pointer-events: none; }
 .cta-band .wrap { position: relative; }
@@ -368,6 +420,7 @@ a { color: inherit; text-decoration: none; }
 .cta-band h2 { font-family: 'Baloo 2', sans-serif; font-weight: 800; font-size: clamp(30px, 4.6vw, 52px); line-height: 1.02; letter-spacing: -0.015em; }
 .cta-band > .wrap > p:not(.chapter) { font-size: 17px; opacity: .92; margin-top: 12px; }
 .cta-band__links { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 34px; }
+.cta-band__links--five { grid-template-columns: repeat(5, 1fr); }
 .cta-band__links a { position: relative; display: flex; flex-direction: column; min-height: 114px; padding: 20px; border: 1px solid rgba(255,255,255,.27); border-radius: 15px; background: rgba(9,13,36,.09); transition: transform var(--dur-reveal), background var(--dur-ack); }
 .cta-band__links a:hover { transform: translateY(-4px); background: rgba(9,13,36,.17); }
