<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BERT" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/bert_violet</item>
        <item name="android:colorBackground">@color/bert_violet</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/bert_violet</item>
        <item name="android:navigationBarColor">@color/bert_violet</item>
        <!-- Android 12+ launch splash: the launcher icon on the app's navy instead of the system default. -->
        <item name="android:windowSplashScreenBackground">@color/bert_violet</item>
    </style>
</resources>
