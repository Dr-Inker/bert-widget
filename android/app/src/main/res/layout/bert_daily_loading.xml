<?xml version="1.0" encoding="utf-8"?>
<!-- First frame of Bert's day, until the note is drawn: the same paper, pixel Bert and a line saying the post from Berthalla is coming. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bert_note_paper"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="14dp">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/bert_note_loading_bert" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:text="The latest post from Berthalla is on its way."
        android:textColor="@color/note_ink"
        android:textSize="15sp" />
</LinearLayout>
