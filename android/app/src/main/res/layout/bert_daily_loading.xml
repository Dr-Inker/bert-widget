<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview and first frame: the same shape as the live Bert widget (portrait left, words right). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0712"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp"
    >

    <ImageView
        android:layout_width="84dp"
        android:layout_height="match_parent"
        android:contentDescription="Bert"
        android:scaleType="centerCrop"
        android:src="@drawable/bert_widget_portrait" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BERT"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Bert’s latest update and mood."
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FF9433"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:text="MOOD · TOURNAMENT"
            android:textColor="#1F0E02"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
